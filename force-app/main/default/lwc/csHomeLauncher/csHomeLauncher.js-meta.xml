<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Bullhorn - Candidate Search Launcher</masterLabel>
    <description>Mini search box for the Home page. Opens Candidate Search with the text.</description>
    <targets>
        <target>lightning__HomePage</target>
        <target>lightning__AppPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__HomePage,lightning__AppPage">
            <property name="heading" type="String" label="Heading" default="Find candidates" />
            <property name="logoUrl" type="String" label="Logo URL (optional)" description="Image URL for the Amplify logo, for example /resource/AmplifyLogo. Blank shows the Amplify wordmark." />
            <property name="tabApiName" type="String" label="Candidate Search tab API name" default="Candidate_Search" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
